{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitBot",
  "version": "0.1.0",
  "identifier": "app.bitbot.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
